# URL pública de l'aplicació. Serveix per construir els enllaços dels missatges.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (Neon, Supabase, Railway, etc.)
# També s'accepta POSTGRES_URL (integracions de Vercel Postgres/Neon).
DATABASE_URL=postgresql://usuari:contrasenya@host/db?sslmode=require
# Per a Postgres local sense SSL: disable
DATABASE_SSL=require

# --- Correu amb Resend (opció recomanada) ---
RESEND_API_KEY=
EMAIL_FROM="Amic invisible <hola@elteudomini.cat>"

# --- Correu amb SMTP (alternativa a Resend) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
